{
  "actorSpecification": 1,
  "name": "workopolis-jobs-scraper",
  "title": "Workopolis Jobs Scraper",
  "description": "Extract job listings from Workopolis.com with detailed information including title, company, location, description, and posting date. Supports keyword search, location filtering, and pagination.",
  "version": "1.0.0",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "input": "./input_schema.json",
  "categories": ["JOBS"],
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Workopolis Jobs",
      "description": "Job listings scraped from Workopolis.com",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "title",
              "company",
              "location",
              "date_posted",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Job Title",
                "format": "text"
              },
              "company": {
                "label": "Company",
                "format": "text"
              },
              "location": {
                "label": "Location",
                "format": "text"
              },
              "date_posted": {
                "label": "Posted Date",
                "format": "text"
              },
              "url": {
                "label": "URL",
                "format": "link"
              }
            }
          }
        }
      }
    }
  },
  "nodeJsVersion": "22",
  "storages": {
    "dataset": "./dataset_schema.json"
  }
}